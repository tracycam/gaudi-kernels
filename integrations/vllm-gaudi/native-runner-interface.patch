@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise the worker factory/stash contract without importing the HPU SDK."""
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+
+class RunnerFactoryTests(unittest.TestCase):
+    def methods(self):
+        source = Path(__file__).resolve().parents[3] / 'vllm_gaudi/v1/worker/hpu_worker.py'
+        names = {'_create_model_runner', '_runner_stash_key'}
+        methods = [node for node in ast.walk(ast.parse(source.read_text()))
+                   if isinstance(node, ast.FunctionDef) and node.name in names]
+        namespace = {'HPUModelRunner': object, 'VllmConfig': object}
+        exec(compile(ast.Module(body=methods, type_ignores=[]), str(source), 'exec'), namespace)
+        return namespace
+
+    def test_custom_runner_is_constructed_and_cannot_reuse_other_backend_stash(self):
+        class Reference:
+            def __init__(self, **kwargs):
+                self.kwargs = kwargs
+
+        class Candidate(Reference):
+            pass
+
+        config = SimpleNamespace(
+            compilation_config=SimpleNamespace(),
+            model_config=SimpleNamespace(model='fixture', dtype='bf16', enforce_eager=False, max_model_len=128),
+            scheduler_config=SimpleNamespace(max_num_batched_tokens=32),
+            cache_config=SimpleNamespace(block_size=128))
+        methods = self.methods()
+        worker = SimpleNamespace(vllm_config=config, is_driver_worker=True, get_model_runner_cls=lambda: Candidate)
+        runner = methods['_create_model_runner'](worker)
+        self.assertIs(type(runner), Candidate)
+        self.assertIs(runner.kwargs['vllm_config'], config)
+        candidate_key = methods['_runner_stash_key'](worker, config)
+        worker.get_model_runner_cls = lambda: Reference
+        self.assertNotEqual(candidate_key, methods['_runner_stash_key'](worker, config))
+
+
+if __name__ == '__main__':
+    unittest.main()
