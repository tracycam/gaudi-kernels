@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: Apache-2.0
+"""CPU execution of the actual runner metadata method, without HPU imports."""
+import ast
+import itertools
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+import numpy as np
+import torch
+from torch.nn.utils.rnn import pad_sequence
+
+
+SOURCE = Path(__file__).resolve().parents[3] / 'vllm_gaudi/v1/worker/hpu_model_runner.py'
+
+
+def runner_method():
+    tree = ast.parse(SOURCE.read_text())
+    methods = [n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef)
+               and n.name in ('_create_decode_input_data', '_window_block_tables')]
+    namespace = dict(torch=torch, np=np, itertools=itertools, pad_sequence=pad_sequence,
+                     DecodeInputData=SimpleNamespace,
+                     HPUAttentionMetadataV1=SimpleNamespace(make_decode_metadata=lambda **kw: SimpleNamespace(**kw)),
+                     async_h2d_copy=lambda value, **kw: value.clone())
+    exec(compile(ast.Module(body=methods, type_ignores=[]), str(SOURCE), 'exec'), namespace)
+    return namespace['_create_decode_input_data']
+
+
+def build_metadata(positions, counts):
+    batch = len(counts)
+    calls = []
+
+    def buffers(tables, slots, capacity, **kwargs):
+        calls.append(dict(tables=tables, slots=slots, window=kwargs.get('force_non_contiguous', False)))
+        return (torch.tensor([page for table in tables for page in table]),
+                torch.tensor([row for row, table in enumerate(tables) for _ in table]),
+                torch.ones(sum(map(len, tables))))
+
+    instance = SimpleNamespace(
+        attn_block_size=128, _PAD_BLOCK_ID=999, _PAD_SLOT_ID=999*128,
+        bucketing_manager=SimpleNamespace(find_decode_bucket=lambda bs, blocks, *args: (bs, 1, blocks)),
+        get_dp_padding=lambda value: 0, uses_mrope=False, pin_memory=False,
+        positions_cpu=torch.tensor([p+j for p, n in zip(positions, counts) for j in range(n)]),
+        input_ids_cpu=torch.arange(sum(counts), dtype=torch.int32),
+        _resolve_block=lambda page: page, _resolve_all_blocks=lambda tables: tables,
+        get_habana_paged_attn_buffers=buffers, interleaved_sliding_window=True, sliding_window=128,
+        model_has_chunked_attention=False, num_mamba_like_layers=0, device='cpu', use_async_scheduling=False)
+    instance.copy_input_to_device = lambda role, value, **kwargs: value.clone()
+    pages = torch.tensor([[100*r+j+10 for j in range(64)] for r in range(batch)], dtype=torch.int32)
+    data = runner_method()(instance, batch, counts, np.array(positions), pages)
+    return data, calls, pages
+
+
+class DecodeQueryPages(unittest.TestCase):
+    def test_single_query_per_request_retains_page_and_slot_identity(self):
+        data, calls, pages = build_metadata([0, 127, 4095], [1, 1, 1])
+        for row, position in enumerate((0, 127, 4095)):
+            self.assertEqual(calls[0]['tables'][row], pages[row, :position//128+1].tolist())
+            self.assertEqual(data.attn_metadata.slot_mapping[row].item(),
+                             pages[row, position//128].item()*128+position%128)
+
+    def test_each_query_sees_its_own_page_prefix(self):
+        for position in (0, 125, 126, 127, 128, 4094, 4095, 4096):
+            data, calls, pages = build_metadata([position], [4])
+            full, window = calls
+            for j in range(4):
+                q = position+j
+                self.assertEqual(full['tables'][j], pages[0, :q//128+1].tolist())
+                self.assertEqual(window['tables'][j], pages[0, max(0, (q-127)//128):q//128+1].tolist())
+                self.assertEqual(data.attn_metadata.slot_mapping[j].item(), pages[0, q//128].item()*128+q%128)
+
+    def test_ragged_padding_never_writes_a_live_page(self):
+        data, calls, pages = build_metadata([127, 126, 4095], [1, 2, 4])
+        full, window = calls
+        for row, count in enumerate((1, 2, 4)):
+            for j in range(4):
+                index = row*4+j
+                slot = data.attn_metadata.slot_mapping[index].item()
+                if j >= count:
+                    self.assertEqual(slot//128, 999)
+                    self.assertEqual(full['tables'][index], [])
+                    self.assertEqual(window['tables'][index], [])
+                else:
+                    self.assertIn(slot//128, pages[row].tolist())
+
+
+if __name__ == '__main__':
+    unittest.main()
